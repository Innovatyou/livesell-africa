# ─── LiveSell Africa API — copy to apps/api/.env and fill in. Never commit real values. ───
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://livesell:livesell@localhost:5432/livesell?schema=public
REDIS_URL=redis://localhost:6379

# openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# openssl rand -base64 32   (exactly 32 bytes — encrypts gateway keys & bank account numbers)
DATA_ENCRYPTION_KEY=
# openssl rand -base64 48
TOKEN_HASH_SECRET=

# true behind HTTPS (required in production)
COOKIE_SECURE=false

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10

# Object storage (S3 API). Dev/test: MinIO from docker-compose.
# Prod: Cloudflare R2 (https://<account>.r2.cloudflarestorage.com, region auto) or AWS S3 (leave S3_ENDPOINT empty).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=livesell-media
S3_ACCESS_KEY_ID=livesell
S3_SECRET_ACCESS_KEY=livesell-minio-dev
S3_FORCE_PATH_STYLE=true
# Public base URL for serving uploaded media (CDN in prod)
S3_PUBLIC_BASE_URL=http://localhost:9000/livesell-media

# Optional: creates/ensures a platform admin when running `npm run seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Public URL of the API (used for the webhook URLs shown to sellers)
API_PUBLIC_URL=http://localhost:4000

# ─── Phase 5: Paystack (platform account: subscriptions + split settlement). Test keys in dev. ───
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Keep false until the webhook signature scheme is confirmed (payments are verified server-side either way)
PAYSTACK_WEBHOOKS_ENABLED=false

# ─── Phase 6: Flutterwave (v3 test keys in dev) ───
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
# Not used (LiveSell uses hosted checkout, not direct card charges)
FLUTTERWAVE_ENCRYPTION_KEY=
# The "secret hash" you set under Settings → Webhooks on the Flutterwave dashboard
FLUTTERWAVE_WEBHOOK_HASH=
FLUTTERWAVE_WEBHOOKS_ENABLED=true

# ─── Phase 6: Bachs (sk_sandbox_ keys in dev; needs payments:read, payments:write, refunds:write scopes) ───
BACHS_API_KEY=
# Signing secret of the webhook endpoint created in the Bachs Developer Portal
BACHS_WEBHOOK_SECRET=
BACHS_WEBHOOKS_ENABLED=true

# ─── Phase 8: Veltrix (messaging + Verify). Nothing is sent until VELTRIX_ENABLED=true ───
VELTRIX_ENABLED=false
# Site root of the Veltrix install, e.g. https://veltrix.ng (the API lives under /api/v1)
VELTRIX_BASE_URL=
# Customer API key of LiveSell's platform Veltrix account
VELTRIX_API_KEY=
# Approved SMS sender ID on that account
VELTRIX_SMS_SENDER=
VELTRIX_EMAIL_FROM=
VELTRIX_EMAIL_FROM_NAME=LiveSell Africa
# server_uid of the WhatsApp number LiveSell sends from (GET /api/v1/whatsapp/senders)
VELTRIX_WHATSAPP_SERVER_UID=
# Veltrix Verify partner credential "<key_id>.<secret>" (automated CAC checks)
VELTRIX_VERIFY_KEY=

# ─── Later phases (leave empty until each integration is approved; feature-flagged off) ───

# ── Operations (Phase 12) ──
# Background jobs (BullMQ schedulers). Keep true on every API instance; schedulers are idempotent.
JOBS_ENABLED=true
# Optional Slack/Teams incoming webhook for 5xx alerts (one per distinct error per 5 minutes).
ALERT_WEBHOOK_URL=
# Staging/production refuse to start with development settings: https URLs, COOKIE_SECURE=true, no localhost,
# no placeholder secrets, and (production only) no test payment keys. See docs/DEPLOYMENT.md.

# ── Mobile push (seller app) ──
# Sends new-order / transfer-report notifications through the Expo push service. FCM/APNs credentials are uploaded to
# EAS (`eas credentials`), not set here.
PUSH_ENABLED=false
# Only if "enhanced push security" is enabled in the Expo dashboard.
EXPO_ACCESS_TOKEN=
