# LiveSell Africa web — copy to apps/web/.env.local
# Public base URL of the API (browser calls it directly with credentials; refresh token stays in its httpOnly cookie).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Legal identity shown in the Terms / Privacy Policy (leave empty to show "LiveSell Africa" and the contact form).
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
